      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (increase(blink_plugin_desired_state_promotions_total{namespace=~\"$namespace\"}[1h]))",
          "legendFormat": "{{namespace}} promotions"
        },
        {
          "refId": "B",
          "expr": "sum by (namespace, result) (increase(blink_plugin_projection_commits_total{namespace=~\"$namespace\"}[1h]))",
          "legendFormat": "{{namespace}} commit {{result}}"
