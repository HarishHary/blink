{
  "uid": "blink-plugin-runtime",
  "title": "Blink Plugin Runtime",
  "description": "Per-namespace plugin runtime state on every executor: readiness and rollout transitions, routers and plugin processes, invocation admission and latency, and the churn behind a degraded route.",
  "tags": ["blink", "plugin"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Plugin namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "blink-prometheus" },
        "query": "label_values(blink_plugin_availability, namespace)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Runtime availability",
      "description": "Worst pod in the namespace: ready only while something is routable, degraded while it serves a stale revision.",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "blink-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (namespace) (blink_plugin_availability{namespace=~\"$namespace\"})",
          "legendFormat": "{{namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "unavailable", "index": 0 },
                "1": { "text": "degraded", "index": 1 },
                "2": { "text": "ready", "index": 2 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "green", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Supervisor lifecycle",
      "description": "Published by the runtime supervisor, which stays up while its children restart underneath it.",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "blink-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (namespace) (blink_plugin_supervisor_lifecycle{namespace=~\"$namespace\"})",
          "legendFormat": "{{namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "starting", "index": 0 },
                "1": { "text": "running", "index": 1 },
                "2": { "text": "draining", "index": 2 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null },
              { "color": "green", "value": 1 },
              { "color": "orange", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Desired-state transition",
      "description": "Anything other than idle means a revision is mid-promotion; a stuck value is what in-flight calls or an uncommitted projection hold.",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "blink-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (namespace) (blink_plugin_transition{namespace=~\"$namespace\"})",
          "legendFormat": "{{namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "idle", "index": 0 },
                "1": { "text": "preparing", "index": 1 },
                "2": { "text": "awaiting freshness", "index": 2 },
                "3": { "text": "awaiting projection", "index": 3 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "blue", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Child availability",
      "description": "The reconciler proposes desired state and the catalog serves it; runtime availability cannot exceed either.",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "blink-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "blink_plugin_reconciler_availability{namespace=~\"$namespace\"}",
          "legendFormat": "{{namespace}} reconciler"
        },
        {
          "refId": "B",
          "expr": "blink_plugin_catalog_availability{namespace=~\"$namespace\"}",
          "legendFormat": "{{namespace}} catalog"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 2,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "unavailable", "index": 0 },
                "1": { "text": "degraded", "index": 1 },
                "2": { "text": "ready", "index": 2 }
              }
            }
          ],
          "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never", "lineInterpolation": "stepAfter" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Desired-state revisions",
      "description": "The reconciler's proposed revision leads; a gap that persists means a promotion never landed.",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "blink-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "blink_plugin_desired_revision{namespace=~\"$namespace\"}",
          "legendFormat": "{{namespace}} applied or pending"
        },
        {
          "refId": "B",
          "expr": "blink_plugin_reconciler_revision{namespace=~\"$namespace\"}",
          "legendFormat": "{{namespace}} proposed"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Projection generations",
      "description": "Calls are admitted against the ready generation; committed leads it while the snapshot subtree is still committing.",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "blink-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "blink_plugin_projection_ready_generation{namespace=~\"$namespace\"}",
          "legendFormat": "{{namespace}} ready"
        },
        {
          "refId": "B",
          "expr": "blink_plugin_projection_committed_generation{namespace=~\"$namespace\"}",
          "legendFormat": "{{namespace}} committed"
        },
        {
          "refId": "C",
          "expr": "blink_plugin_reconciler_generation{namespace=~\"$namespace\"}",
          "legendFormat": "{{namespace}} reconciler resolved"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Routers",
      "description": "Settled below desired means a rollout is still moving; unavailable routers are plugins whose events dead-letter while the rest keep serving.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "blink-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (blink_plugin_routers_desired{namespace=~\"$namespace\"})",
          "legendFormat": "{{namespace}} desired"
        },
        {
          "refId": "B",
          "expr": "sum by (namespace) (blink_plugin_routers_routable{namespace=~\"$namespace\"})",
          "legendFormat": "{{namespace}} routable"
        },
        {
          "refId": "C",
          "expr": "sum by (namespace) (blink_plugin_routers_settled{namespace=~\"$namespace\"})",
          "legendFormat": "{{namespace}} settled"
        },
        {
          "refId": "D",
          "expr": "sum by (namespace) (blink_plugin_routers_unavailable{namespace=~\"$namespace\"})",
          "legendFormat": "{{namespace}} unavailable"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" } },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*unavailable.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Plugin processes",
      "description": "Ready below desired means slots are waiting on a restart backoff or on the shared process budget.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "blink-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (blink_plugin_processes_ready{namespace=~\"$namespace\"})",
          "legendFormat": "{{namespace}} ready"
        },
        {
          "refId": "B",
          "expr": "sum by (namespace) (blink_plugin_processes_desired{namespace=~\"$namespace\"})",
          "legendFormat": "{{namespace}} desired"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Calls in flight and queued",
      "description": "In-flight is what a transition waits on; queue depth rising with flat active calls is process capacity, not plugin latency.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "blink-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (blink_plugin_in_flight_calls{namespace=~\"$namespace\"})",
          "legendFormat": "{{namespace}} in flight"
        },
        {
          "refId": "B",
          "expr": "sum by (namespace) (blink_plugin_active_calls{namespace=~\"$namespace\"})",
          "legendFormat": "{{namespace}} executing"
        },
        {
          "refId": "C",
          "expr": "sum by (namespace) (blink_plugin_queue_depth{namespace=~\"$namespace\"})",
          "legendFormat": "{{namespace}} queued"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Invocations by result",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "blink-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, result) (rate(blink_plugin_invocations_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "{{namespace}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Invocation latency",
      "description": "A deployment manager accepting one invocation to completing it, so queueing is included.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "blink-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (namespace, le) (rate(blink_plugin_invocation_seconds_bucket{namespace=~\"$namespace\"}[5m])))",
          "legendFormat": "{{namespace}} p99"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (namespace, le) (rate(blink_plugin_invocation_seconds_bucket{namespace=~\"$namespace\"}[5m])))",
          "legendFormat": "{{namespace}} p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.5, sum by (namespace, le) (rate(blink_plugin_invocation_seconds_bucket{namespace=~\"$namespace\"}[5m])))",
          "legendFormat": "{{namespace}} p50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Rejections and timeouts",
      "description": "Every way a call fails before a plugin sees it: admission budget, no route, no manager acknowledgement, a full deployment queue, or no process started in time.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "blink-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, reason) (rate(blink_plugin_invocations_rejected_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "{{namespace}} admission {{reason}}"
        },
        {
          "refId": "B",
          "expr": "sum by (namespace) (rate(blink_plugin_unroutable_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "{{namespace}} unroutable"
        },
        {
          "refId": "C",
          "expr": "sum by (namespace) (rate(blink_plugin_acceptance_timeouts_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "{{namespace}} acceptance timeout"
        },
        {
          "refId": "D",
          "expr": "sum by (namespace) (rate(blink_plugin_queue_rejects_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "{{namespace}} queue full"
        },
        {
          "refId": "E",
          "expr": "sum by (namespace) (rate(blink_plugin_dispatch_timeouts_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "{{namespace}} dispatch timeout"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Routing by rollout target",
      "description": "Which side of a canary or shadow rollout each call took.",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "blink-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, target) (rate(blink_plugin_routed_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "{{namespace}} {{target}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Scale events",
      "description": "Autoscaling decisions past a deployment's min_procs, bounded by the process budget shared across the pod.",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "blink-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, direction) (increase(blink_plugin_scale_events_total{namespace=~\"$namespace\"}[1h]))",
          "legendFormat": "{{namespace}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Plugin process churn",
      "description": "Restarts spend a slot's retry budget; a circuit open is that budget exhausted, which stops admitting calls for the cooldown.",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "blink-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (increase(blink_plugin_process_starts_total{namespace=~\"$namespace\"}[1h]))",
          "legendFormat": "{{namespace}} starts"
        },
        {
          "refId": "B",
          "expr": "sum by (namespace) (increase(blink_plugin_process_restarts_total{namespace=~\"$namespace\"}[1h]))",
          "legendFormat": "{{namespace}} restarts"
        },
        {
          "refId": "C",
          "expr": "sum by (namespace, reason) (increase(blink_plugin_process_terminations_total{namespace=~\"$namespace\"}[1h]))",
          "legendFormat": "{{namespace}} exit {{reason}}"
        },
        {
          "refId": "D",
          "expr": "sum by (namespace) (increase(blink_plugin_circuit_opens_total{namespace=~\"$namespace\"}[1h]))",
          "legendFormat": "{{namespace}} circuit opens"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*circuit opens.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Reconciler resolutions",
      "description": "Deferred and stale resolutions are the ones that need a retry, and an artifact worker restart is what re-reads the catalog after one.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 41 },
      "datasource": { "type": "prometheus", "uid": "blink-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, result) (increase(blink_plugin_resolutions_total{namespace=~\"$namespace\"}[1h]))",
          "legendFormat": "{{namespace}} {{result}}"
        },
        {
          "refId": "B",
          "expr": "sum by (namespace) (increase(blink_plugin_resolution_retries_total{namespace=~\"$namespace\"}[1h]))",
          "legendFormat": "{{namespace}} retries"
        },
        {
          "refId": "C",
          "expr": "sum by (namespace, worker) (increase(blink_plugin_artifact_worker_restarts_total{namespace=~\"$namespace\"}[1h]))",
          "legendFormat": "{{namespace}} {{worker}} restarts"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Router churn",
      "description": "A promotion retires the routers serving the old revision, so starts and terminations track rollouts as much as failures.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 41 },
      "datasource": { "type": "prometheus", "uid": "blink-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (increase(blink_plugin_router_starts_total{namespace=~\"$namespace\"}[1h]))",
          "legendFormat": "{{namespace}} starts"
        },
        {
          "refId": "B",
          "expr": "sum by (namespace) (increase(blink_plugin_router_restarts_total{namespace=~\"$namespace\"}[1h]))",
          "legendFormat": "{{namespace}} restarts"
        },
        {
          "refId": "C",
          "expr": "sum by (namespace, reason) (increase(blink_plugin_router_terminations_total{namespace=~\"$namespace\"}[1h]))",
          "legendFormat": "{{namespace}} exit {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Promotions and projection commits",
      "description": "One promotion per revision that reached the catalog; a failed commit is what leaves the transition awaiting the projection.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 48 },
